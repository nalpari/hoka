<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hoka.bo.sample.SampleMapper">

    <select id="findAll" resultType="com.hoka.bo.sample.Sample">
        select id, name, created_at from sample order by id
    </select>

    <select id="findById" resultType="com.hoka.bo.sample.Sample">
        select id, name, created_at from sample where id = #{id}
    </select>

    <!-- insert/update는 PostgreSQL returning으로 결과 행을 받으므로 select로 선언한다. 같은 세션의 조회 캐시를 타지 않게 flushCache를 켠다. -->
    <select id="insert" resultType="com.hoka.bo.sample.Sample" flushCache="true">
        insert into sample (name) values (#{name}) returning id, name, created_at
    </select>

    <select id="update" resultType="com.hoka.bo.sample.Sample" flushCache="true">
        update sample set name = #{name} where id = #{id} returning id, name, created_at
    </select>

    <delete id="delete">
        delete from sample where id = #{id}
    </delete>

</mapper>
